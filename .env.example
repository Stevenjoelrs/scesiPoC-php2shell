# Copy to .env (make env does this automatically).

# The official PHP images are amd64; keep this on Apple Silicon too so the
# libphp.so offsets used by the exploit match the target.
PLATFORM=linux/amd64

# Vulnerable / patched official tags.
VULN_IMAGE=php:8.4.26-apache
PATCHED_IMAGE=php:8.4.27-apache

# Host ports, bound to 127.0.0.1 by docker/compose.yml.
VULN_PORT=8088
PATCHED_PORT=8089
